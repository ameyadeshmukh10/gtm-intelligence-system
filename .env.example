HUBSPOT_TOKEN=pat-xxx-...
HUBSPOT_CLIENT_SECRET=...
HUBSPOT_BASE_URL=https://api.hubapi.com
PIPELINE_DATA_DIR=./data

# --- Web app (webapp/) ---
# Single shared-password gate. Leave EMPTY to disable auth (local dev only).
APP_PASSWORD=
# Secret used to sign session cookies. Set a long random value in production.
SESSION_SECRET=change-me-to-a-long-random-string
# Background worker threads (keep small to respect HubSpot rate limits).
N_WORKERS=2
# Optional: default Apple Numbers budget workbook for one-click MMM rebuild.
BUDGET_WORKBOOK_PATH=
# Optional: override SQLite location (defaults to $PIPELINE_DATA_DIR/app.db).
# APP_DB_PATH=./data/app.db
